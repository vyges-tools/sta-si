design:      top
netlist:     top.v
lib:         cells.lib
spef:        top.spef     # parasitics -> wire load + Elmore net delay
clock:       clk 1.0      # port + period (ns)
input_delay: 0.0          # declared, so port `a` is a timing start point.
                          # Without this the port is UNCONSTRAINED and starts no path at
                          # all — which is what OpenSTA does, and what this fixture does
                          # not want, since its whole purpose is a timed input-to-flop path.
input_slew:  0.02         # ns
output_load: 0.005        # pF at the primary output
late_derate: 1.0          # OCV late derate on cell delays
