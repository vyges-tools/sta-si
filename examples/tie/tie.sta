# Constant (tie-cell) propagation: a net driven by `function : "1"`/`"0"` never switches,
# so it carries no timing — and a gate with one constant input must still time through
# its other input.
design:      tie
netlist:     tie.v
lib:         tie.lib
clock:       clk 2.0
input_slew:  0.02
output_load: 0.005
# Declared so the primary inputs are timing start points. Without it they are
# UNCONSTRAINED and start no path at all — matching OpenSTA — which would make this
# fixture's constant-propagation assertions vacuous rather than passing.
input_delay: 0.0
