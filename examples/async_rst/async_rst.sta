# Async set/reset fixture: exercises recovery (setup-side) and removal (hold-side)
# checks on RESET_B, which carries neither setup nor hold and so was previously
# left entirely unchecked.
design:      async_rst
netlist:     async_rst.v
lib:         async_rst.lib
clock:       clk 2.0
input_slew:  0.02
output_load: 0.005
# Declared so the reset port is a timing start point. Without it the port is
# UNCONSTRAINED and starts no path — matching OpenSTA — and the removal check these
# tests exist to exercise would have nothing arriving at it to check.
input_delay: 0.0
